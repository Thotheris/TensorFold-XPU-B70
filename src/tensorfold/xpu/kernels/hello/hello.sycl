// K0 smoke kernels: each launches on the current XPU stream's queue, and each result is exact for the test inputs.

#include <ATen/ATen.h>
#include <c10/xpu/XPUStream.h>
#include <sycl/ext/oneapi/matrix/matrix.hpp>
#include <sycl/sycl.hpp>

namespace {

namespace mx = sycl::ext::oneapi::experimental::matrix;
using bf16 = sycl::ext::oneapi::bfloat16;

class HelloAdd;
class HelloSgSum;
class HelloDpas;

template <typename T>
auto global(T* p) {
    return sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(p);
}

void check(const at::Tensor& t, at::ScalarType dtype, const char* name) {
    TORCH_CHECK(t.is_xpu() && t.scalar_type() == dtype && t.is_contiguous(), name, " must be a contiguous XPU tensor");
}

}  // namespace

at::Tensor hello_add(const at::Tensor& a, const at::Tensor& b) {
    check(a, at::kFloat, "a");
    check(b, at::kFloat, "b");
    TORCH_CHECK(a.sizes() == b.sizes(), "a and b must have the same shape");
    auto out = at::empty_like(a);
    const float* pa = a.data_ptr<float>();
    const float* pb = b.data_ptr<float>();
    float* po = out.data_ptr<float>();
    const size_t n = a.numel();
    c10::xpu::getCurrentXPUStream().queue().parallel_for<HelloAdd>(sycl::range<1>(n),
                                                                   [=](sycl::id<1> i) { po[i] = pa[i] + pb[i]; });
    return out;
}

// Each lane of a sub-group of 16 ends with the sum of all 16 values: xor partners 8, 4, 2, 1, one add per step.
at::Tensor hello_sg_sum(const at::Tensor& x) {
    check(x, at::kFloat, "x");
    TORCH_CHECK(x.numel() % 16 == 0, "x must hold whole sub-groups of 16");
    auto out = at::empty_like(x);
    const float* px = x.data_ptr<float>();
    float* po = out.data_ptr<float>();
    const size_t n = x.numel();
    c10::xpu::getCurrentXPUStream().queue().parallel_for<HelloSgSum>(
        sycl::nd_range<1>(n, 16), [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
            const auto sg = it.get_sub_group();
            float v = px[it.get_global_id(0)];
            for (int m = 8; m; m >>= 1) v = v + sycl::permute_group_by_xor(sg, v, m);
            po[it.get_global_id(0)] = v;
        });
    return out;
}

// C (8x16 fp32) = A (8x16 bf16) x B (16x16 bf16), one sub-group, one DPAS 8x16x16 through joint_matrix.
at::Tensor hello_dpas(const at::Tensor& a, const at::Tensor& b) {
    check(a, at::kBFloat16, "a");
    check(b, at::kBFloat16, "b");
    TORCH_CHECK(a.size(0) == 8 && a.size(1) == 16 && b.size(0) == 16 && b.size(1) == 16, "a is 8x16 and b 16x16");
    auto out = at::empty({8, 16}, a.options().dtype(at::kFloat));
    const bf16* pa = reinterpret_cast<const bf16*>(a.data_ptr());
    const bf16* pb = reinterpret_cast<const bf16*>(b.data_ptr());
    float* pc = out.data_ptr<float>();
    c10::xpu::getCurrentXPUStream().queue().parallel_for<HelloDpas>(
        sycl::nd_range<2>({1, 16}, {1, 16}), [=](sycl::nd_item<2> it) [[sycl::reqd_sub_group_size(16)]] {
            const auto sg = it.get_sub_group();
            mx::joint_matrix<sycl::sub_group, bf16, mx::use::a, 8, 16, mx::layout::row_major> ma;
            mx::joint_matrix<sycl::sub_group, bf16, mx::use::b, 16, 16, mx::layout::row_major> mb;
            mx::joint_matrix<sycl::sub_group, float, mx::use::accumulator, 8, 16> mc;
            mx::joint_matrix_fill(sg, mc, 0.0f);
            mx::joint_matrix_load(sg, ma, global(pa), 16);
            mx::joint_matrix_load(sg, mb, global(pb), 16);
            mx::joint_matrix_mad(sg, mc, ma, mb, mc);
            mx::joint_matrix_store(sg, mc, global(pc), 16, mx::layout::row_major);
        });
    return out;
}

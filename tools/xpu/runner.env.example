# Copy to ~/.config/tensorfold-xpu/runner.env and replace /home/operator.
# EnvironmentFile does not expand $HOME, ~ or references to other variables.
# Do not put tokens here. The runner scrubs them from bundles, but the box should not need them.
# Do not set oneAPI variables or source DLE in the runner's runtime environment.
TF_XPU_REPO=/home/operator/.local/share/tensorfold-xpu/repo
TF_XPU_PYTHON=/home/operator/.local/share/tensorfold-xpu/venv/bin/python
TF_XPU_VENV=/home/operator/.local/share/tensorfold-xpu/venv
TF_XPU_WORK=/home/operator/.local/share/tensorfold-xpu/work
TF_XPU_STATE_DIR=/home/operator/.local/state/tensorfold-xpu
HF_HOME=/home/operator/.cache/huggingface
TF_XPU_REMOTE=origin
